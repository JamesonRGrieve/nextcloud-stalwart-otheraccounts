{
    "name": "jamesonrgrieve/nextcloud-stalwart-otheraccounts",
    "description": "Nextcloud app: self-service enrollment of external mailboxes (Google XOAUTH2 or IMAP) into a user's Stalwart mailbox via OpenBao, NetBox and Semaphore",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [{ "name": "Jameson" }],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "nextcloud/ocp": "dev-stable34"
    },
    "autoload": {
        "psr-4": { "OCA\\OtherAccounts\\": "lib/" }
    },
    "autoload-dev": {
        "psr-4": { "OCA\\OtherAccounts\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.4.0" },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "post-install-cmd": ["git config core.hooksPath .githooks"],
        "lint": "find lib tests appinfo -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
